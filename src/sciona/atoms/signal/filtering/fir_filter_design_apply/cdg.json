{
  "cdg_id": "fir_filter_design_apply",
  "name": "fir_filter_design_apply",
  "priority": "medium",
  "decomposition_rationale": "Splitting filter coefficient design from the actual filtering operation is crucial because filter design is typically done once, whereas filtering is applied repeatedly to incoming blocks or multiple signals.",
  "family_directory_hint": "src/sciona/atoms/signal/filtering/",
  "atomic_nodes": [
    {
      "name": "design_fir_coefficients_window",
      "semantic_role": "Designs linear-phase FIR filter coefficients using the window method.",
      "source_targets": [
        "scipy.signal.firwin"
      ],
      "inputs": [
        {
          "name": "numtaps",
          "type_desc": "int",
          "required": true,
          "constraints": "Positive integer, odd for linear phase type I"
        },
        {
          "name": "cutoff",
          "type_desc": "float | NDArray[np.float64]",
          "required": true,
          "constraints": "Normalized cutoff frequency (0 to 1)"
        },
        {
          "name": "window_type",
          "type_desc": "str",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "numtaps > 0"
      ],
      "postcondition_candidates": [
        "result.shape[0] == numtaps"
      ],
      "witness_shape_semantics": "Produces a 1D filter coefficient vector of length numtaps.",
      "time_complexity": "O(numtaps)",
      "space_complexity": "O(numtaps)",
      "complexity_reasoning": "Linear computation of sinc functions and window multiplication.",
      "complexity_confidence": 95
    },
    {
      "name": "apply_fir_lfilter",
      "semantic_role": "Applies a designed FIR filter to a signal using direct-form II transposed structure.",
      "source_targets": [
        "scipy.signal.lfilter"
      ],
      "inputs": [
        {
          "name": "b",
          "type_desc": "NDArray[np.float64]",
          "required": true,
          "constraints": "Filter numerator coefficients (FIR taps)"
        },
        {
          "name": "signal",
          "type_desc": "NDArray[np.float64]",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "b.ndim == 1",
        "signal.ndim >= 1"
      ],
      "postcondition_candidates": [
        "result.shape == signal.shape"
      ],
      "witness_shape_semantics": "Maintains the shape of the input signal during filtering.",
      "time_complexity": "O(n * numtaps)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Computes direct inner product per sample.",
      "complexity_confidence": 97
    }
  ],
  "edges": [
    {
      "source": "design_fir_coefficients_window",
      "target": "apply_fir_lfilter",
      "output_name": "result",
      "input_name": "b"
    }
  ],
  "cdg_io": {
    "inputs": [
      {
        "name": "signal",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "numtaps",
        "type_desc": "int",
        "required": true
      },
      {
        "name": "cutoff",
        "type_desc": "float",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "filtered_signal",
        "type_desc": "NDArray[np.float64]"
      }
    ]
  },
  "state_model_needed": false
}