{
  "cdg_id": "stft_time_frequency_analysis",
  "name": "stft_time_frequency_analysis",
  "priority": "medium",
  "decomposition_rationale": "STFT requires frame segmentation with overlap, and a forward DFT per frame.ISTFT requires the inverse DFT and overlap-add synthesis. Decomposing these allows reusing individual framing/unframing operations for non-spectral frame-based analyses.",
  "family_directory_hint": "src/sciona/atoms/signal/spectral/",
  "atomic_nodes": [
    {
      "name": "segment_into_overlapping_frames",
      "semantic_role": "Segments a 1D signal into overlapping frames with specified window size and hop length.",
      "source_targets": [
        "scipy.signal.stft",
        "librosa.util.frame"
      ],
      "inputs": [
        {
          "name": "signal",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "frame_length",
          "type_desc": "int",
          "required": true
        },
        {
          "name": "hop_length",
          "type_desc": "int",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "signal.ndim == 1",
        "frame_length > 0",
        "hop_length > 0",
        "hop_length <= frame_length"
      ],
      "postcondition_candidates": [
        "result.ndim == 2",
        "result.shape[0] == frame_length"
      ],
      "witness_shape_semantics": "Transforms input of shape (N,) to (frame_length, num_frames) where num_frames is approximately N // hop_length.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Strided view creation or array copy into segmented blocks.",
      "complexity_confidence": 92
    },
    {
      "name": "compute_frame_fft",
      "semantic_role": "Applies a window and computes the DFT for each signal frame.",
      "source_targets": [
        "scipy.fft.rfft"
      ],
      "inputs": [
        {
          "name": "frames",
          "type_desc": "NDArray[np.float64]",
          "required": true,
          "constraints": "2D array of shape (frame_length, num_frames)"
        },
        {
          "name": "window_type",
          "type_desc": "str",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type_desc": "NDArray[np.complex128]"
        }
      ],
      "precondition_candidates": [
        "frames.ndim == 2"
      ],
      "postcondition_candidates": [
        "result.ndim == 2",
        "result.shape[0] == frames.shape[0] // 2 + 1"
      ],
      "witness_shape_semantics": "Returns complex spectrum of shape (frame_length // 2 + 1, num_frames).",
      "time_complexity": "O(k * m log(m))",
      "space_complexity": "O(k * m)",
      "complexity_reasoning": "Applies FFT of size m to each of the k frames.",
      "complexity_confidence": 96
    }
  ],
  "edges": [
    {
      "source": "segment_into_overlapping_frames",
      "target": "compute_frame_fft",
      "output_name": "result",
      "input_name": "frames"
    }
  ],
  "cdg_io": {
    "inputs": [
      {
        "name": "signal",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "frame_length",
        "type_desc": "int",
        "required": true
      },
      {
        "name": "hop_length",
        "type_desc": "int",
        "required": true
      },
      {
        "name": "window_type",
        "type_desc": "str",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "stft_matrix",
        "type_desc": "NDArray[np.complex128]"
      }
    ]
  },
  "state_model_needed": false
}